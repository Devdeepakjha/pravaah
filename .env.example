# ==============================================================================
# PRAVAAH - Environmental Intelligence & Landslide Prediction Platform
# Environment Configuration Template (Variable Names Only - No Secrets)
# ==============================================================================

# Next.js Frontend Configuration
# In production on Vercel, set BACKEND_URL to your deployed Render URL (e.g. https://pravaah-api.onrender.com)
BACKEND_URL=
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# FastAPI ML Backend Configuration
PORT=8000
HOST=0.0.0.0
# Comma-separated allowed frontend domains (e.g. https://pravaah.vercel.app)
CORS_ORIGINS=
CORS_ORIGIN_REGEX=

# India Meteorological Department (IMD) Live Weather Integration
# Leave blank to operate in calibrated DEMO_REPLAY mode with zero downtime
IMD_API_KEY=
IMD_BASE_URL=https://mausam.imd.gov.in/api/v1
WEATHER_CACHE_TTL_SECONDS=600
WEATHER_PROVIDER_PREFERENCE=auto

# AI / Vision Screening Engine
MAX_UPLOAD_SIZE_MB=10
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp
